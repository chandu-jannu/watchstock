# Copy this file to ".env" and fill in real values. Never commit ".env".

# Random long string used to sign login sessions (JWTs).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Resend.com API key, used to email OTP codes. Get one free at https://resend.com
RESEND_API_KEY=

# The "from" address Resend sends as. While testing you can use their shared
# sandbox domain: "StockSense <onboarding@resend.dev>". For production,
# verify your own domain in Resend and use an address on it.
EMAIL_FROM=StockSense <onboarding@resend.dev>

# Your deployed frontend's origin, for CORS. Use * while developing locally.
FRONTEND_ORIGIN=*

PORT=4000

# --- MySQL connection (only needed if you swap db.js for db.mysql.js) ---
# If MySQL is running on your OTHER laptop, DB_HOST is that laptop's local
# network IP (e.g. 192.168.1.42), NOT "localhost" — localhost means "this
# machine" and would point at nothing. See the chat reply for how to find
# this IP and make MySQL reachable from another machine.
DB_HOST=192.168.1.42
DB_PORT=3306
DB_USER=stocksense_app
DB_PASSWORD=
DB_NAME=stocksense

